# 示例配置。复制成 agents.toml 再按自己的项目改：
#   copy agents.toml.example agents.toml
#
# 最小可用：一个主控 + 一个执行者。多线就继续加 [agent.x] 段。
# 字段含义见 docs/CURRENT.md；provider 名称见 src/adapters/table.ts。

schema = 1

[protocol]
max_summary = 200
max_detail = 4000

[project]
name = "示例项目"
root = "D:/YourProject"

# 通知（可选）：任务进终态时喊一声。不配就只走界面内的提示。
# webhook 按地址自动适配格式：企业微信群机器人 / Server酱 / PushPlus / 通用 JSON。
# 多个通道用 webhook / webhook2 / webhook3，或用逗号分隔。
#[notify]
#webhook = "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=REPLACE_ME"
#on = "blocked,failed,done"

[limits]
# 同时跑几个 CLI 进程（和任务内车道共用这个池）。1–16
concurrency = 3
# 单任务 token 上限，0 = 不限；超了停在轮次边界转 blocked，加预算可续跑
max_tokens = 0
# 单任务时长上限（分钟），0 = 不限
max_minutes = 0
# 失败后要不要让主控自己复盘一轮（多一次模型调用，换来「为什么失败」）
diagnose = true

[spawn]
auto_approve = false
defaults_enabled = false
role = "executor"
model = ""
timeout_min = 30
access = "write"
task_prefix = ""

[root]
id = "a"
parent = ""
name = "主控"
plugin = "codebuddy"
workspace = "a"
timeout_min = 20
access = "write"
role = "executor"
model = ""

[agent.b]
id = "b"
parent = "a"
name = "执行者"
plugin = "codebuddy"
workspace = "b"
timeout_min = 30
access = "write"
role = "executor"
model = ""
